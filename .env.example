# Environment Configuration Example
# Copy this file to .env and update values for your environment

# Service Configuration
SERVICE_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
POSTGRES_USER=kidcomic
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=storyme

# JWT Authentication
JWT_SECRET=change-me-use-strong-random-value-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Service Ports
STORY_SERVICE_PORT=8000
PAYMENT_SERVICE_PORT=8002
PHOTO_SERVICE_PORT=8001
USER_SERVICE_PORT=8003
CONTENT_SERVICE_PORT=8004

# API Gateway (Traefik)
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Observability Stack
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
TEMPO_PORT=4317
TEMPO_HTTP_PORT=3200

# Service Discovery (Consul)
CONSUL_PORT=8500
CONSUL_HOST=consul

# Tracing Configuration
TRACE_ENABLED=true
TRACE_EXPORTER=otlp
TRACE_ENDPOINT=http://tempo:4317

# Metrics Configuration
METRICS_PORT=9090
METRICS_PATH=/metrics

# Service Registry
SERVICE_NAME=undefined
SERVICE_VERSION=v0.0.1
SERVICE_HOST=localhost
